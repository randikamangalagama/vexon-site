rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "vexonstudiosmain@gmail.com";
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /shoots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
